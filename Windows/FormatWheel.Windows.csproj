<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF><UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable><ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>FormatWheel</AssemblyName><Version>0.3.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="15.0.0" />
    <PackageReference Include="PDFsharp" Version="6.2.2" />
    <PackageReference Include="PdfPig" Version="0.1.13" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.31.0" />
  </ItemGroup>
  <ItemGroup><None Update="*.json;*.onnx" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="en.json;weapons.json;weapon-map.json;u2netp.onnx" LogicalName="Assets.%(Filename)%(Extension)" />
    <EmbeddedResource Include="licenses/*;README-Windows.md;THIRD-PARTY-NOTICES.md" LogicalName="Docs.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../LICENSE" LogicalName="Docs.LICENSE" />
  </ItemGroup>
</Project>
